# Required backend configuration
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=cpgist
# Comma-separated browser origins allowed to call the backend directly.
# If Vercel proxies /api to this backend, set the production frontend origin.
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# Resend transactional email (backend only). Create a key at https://resend.com/api-keys.
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Must be a sender address on a domain verified in Resend.
# For initial testing, Resend may allow onboarding@resend.dev with restricted recipients.
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=CPGist AI
FRONTEND_URL=https://<your-vercel-domain>

# Required only for live AI Analyst requests
EMERGENT_LLM_KEY=replace-with-your-provider-key
# Optional timezone used by date helpers
APP_TZ=UTC
