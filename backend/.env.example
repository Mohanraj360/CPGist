# Required backend configuration
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=cpgist
# Comma-separated browser origins allowed to call the backend directly.
# If Vercel proxies /api to this backend, set the production frontend origin.
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# Preferred transactional email: Gmail API sends as cpgistai@gmail.com over HTTPS (not SMTP).
# Authorize the Gmail account with the gmail.send OAuth scope and store the refresh token privately in Render.
GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=replace-with-refresh-token
GMAIL_SENDER_EMAIL=cpgistai@gmail.com
EMAIL_REPLY_TO=cpgistai@gmail.com

# Optional Resend fallback. The From address MUST be verified in Resend.
RESEND_API_KEY=replace-with-a-new-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=CPGist AI
FRONTEND_URL=https://cpgist.vercel.app

# First-party Google OAuth (create a Web application OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Must exactly match the Authorized redirect URI configured in Google Cloud.
GOOGLE_REDIRECT_URI=https://cpgist.vercel.app/api/auth/google/callback

# Required only for live AI Analyst requests
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional timezone used by date helpers
APP_TZ=UTC
